default_platform(:ios)

# Phase 3-4 — TestFlight + App Store 자동 배포.
# 사용자 사전 작업:
# 1. brew install fastlane
# 2. App Store Connect API key (.p8) 생성 → ASC_PRIVATE_KEY/ASC_KEY_ID/ASC_ISSUER_ID 환경변수
#    (StoreKit 서버 검증과 동일 key 재사용 가능)
# 3. fastlane 실행 디렉토리에서: bundle install (Gemfile 별도 생성 시) 또는 brew 직접
#
# Lanes:
#   fastlane beta     — TestFlight 업로드 (build number bump + archive + pilot upload)
#   fastlane release  — App Store 제출 (build + archive + deliver upload + submission)
#   fastlane bump     — version bump only (project.yml MARKETING_VERSION)

platform :ios do

  before_all do
    # xcodegen 재생성 — project.yml 기반
    sh "cd .. && xcodegen generate"
  end

  desc "TestFlight 업로드 — build number 자동 증가 + archive + pilot upload"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_PRIVATE_KEY_PATH"],   # .p8 파일 경로 (FASTLANE 전용 env)
      duration: 1200,
      in_house: false
    )

    # build number 자동 증가 (CFBundleVersion). MARKETING_VERSION은 수동.
    increment_build_number(xcodeproj: "Unse.xcodeproj")

    # archive + IPA 생성
    build_app(
      project: "Unse.xcodeproj",
      scheme: "Unse",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Unse.ipa",
      clean: true,
      skip_package_dependencies_resolution: false
    )

    # TestFlight 업로드 (메타데이터/screenshot 없이, 빌드만)
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: "build/Unse.ipa"
    )
  end

  desc "App Store 제출 — beta 통과한 빌드를 App Store 메타데이터와 함께 제출"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_PRIVATE_KEY_PATH"],
      duration: 1200,
      in_house: false
    )

    # release 빌드는 별도 archive 후 deliver로 메타데이터 + 스크린샷 + 빌드 모두 업로드.
    # 메타데이터(설명/키워드 등) 변경이 없으면 skip_metadata: true.
    deliver(
      api_key: api_key,
      submit_for_review: false,           # 우선 false — 검토 후 수동 submit 권장
      automatic_release: false,
      skip_screenshots: true,              # 스크린샷은 Phase 추가 별도 lane (snapshot)
      skip_metadata: false,
      force: true                          # HTML preview 건너뜀
    )
  end

  desc "version bump only — project.yml MARKETING_VERSION 수정 (MAJOR.MINOR.PATCH 자동 증가)"
  lane :bump do |options|
    type = options[:type] || "patch"     # major | minor | patch
    sh "cd .. && fastlane run increment_version_number bump_type:#{type} xcodeproj:Unse.xcodeproj"
    UI.success "version bumped (#{type}). 다음: fastlane beta 또는 release"
  end
end
