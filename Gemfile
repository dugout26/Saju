source "https://rubygems.org"

# fastlane — TestFlight + App Store 자동 배포. 버전 고정으로 brew 표류 방지.
# 사용:
#   gem install bundler:2.5.22    # 시스템 bundler 1.x면 한 번 갱신 (BUNDLED WITH 2.5.22)
#   bundle install
#   bundle exec fastlane beta | release | bump
#
# 버전 제약: ~> 2.230 → >= 2.230, < 3.0. 정확 버전은 Gemfile.lock에 고정.
gem "fastlane", "~> 2.230"
